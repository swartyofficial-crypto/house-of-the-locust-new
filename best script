local function newSlider(parent, key, minV, maxV, defV, callback, accent)
    accent = accent or RENK.cyan
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, -4, 0, 40)
    box.BackgroundColor3 = RENK.beyaz
    box.BackgroundTransparency = 0.92
    box.BorderSizePixel = 0
    box.ZIndex = 9
    box.Parent = parent
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 8); bc.Parent = box
    local bs = Instance.new("UIStroke"); bs.Color = accent; bs.Thickness = 1.2; bs.Transparency = 0.3; bs.Parent = box

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 140, 0, 18)
    lbl.Position = UDim2.new(0, 8, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = T()[key] .. ": " .. tostring(defV)
    lbl.TextColor3 = RENK.beyaz
    lbl.Font = FONT_MED
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 10
    lbl.Active = false
    lbl.Parent = box

    local entry = {obj = lbl, key = key, type = "slider", value = defV, accent = accent}
    table.insert(TextElements, entry)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 8)
    track.Position = UDim2.new(0, 10, 0, 26)
    track.BackgroundColor3 = RENK.bg
    track.BorderSizePixel = 0
    track.ZIndex = 10
    track.Parent = box
    local tcc = Instance.new("UICorner"); tcc.CornerRadius = UDim.new(1, 0); tcc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 10
    fill.Parent = track
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, -8, 0.5, -8)
    knob.BackgroundColor3 = RENK.beyaz
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

    local function setV(v)
        v = math.clamp(v, minV, maxV)
        v = math.floor(v + 0.5)
        entry.value = v
        local a = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, -8, 0.5, -8)
        lbl.Text = T()[key] .. ": " .. tostring(v)
        callback(v)
    end
    setV(defV)

    local drag = false
    local function upd(i)
        local ax = track.AbsolutePosition.X
        local aw = track.AbsoluteSize.X
        if aw <= 0 then return end
        local a = math.clamp((i.Position.X - ax) / aw, 0, 1)
        setV(minV + a * (maxV - minV))
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(i)
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(i)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
    return box
end

