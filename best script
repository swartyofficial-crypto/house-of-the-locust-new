    local t = 0
    while ScreenGui.Parent do
        t = t + 0.03
        for _, v in ipairs(yuzerResimler) do
            if v.resim.Parent then
                local xOff = math.sin(t * v.hiz + v.faz) * v.genlik
                local yOff = math.cos(t * v.hiz * 0.8 + v.faz) * v.genlik
                v.resim.Position = UDim2.new(
                    v.baslangicPoz.X.Scale, v.baslangicPoz.X.Offset + xOff,
                    v.baslangicPoz.Y.Scale, v.baslangicPoz.Y.Offset + yOff
                )
                v.resim.Rotation = v.baslangicRot + math.sin(t * v.donmeHizi) * 20
            end
        end
        task.wait(0.03)
    end
end)

