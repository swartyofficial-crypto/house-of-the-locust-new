                    if d < bestD then bestD = d; best = hrp end
                end
            end
        end
        if best then
            if godActive then stopGod(); State.GodMode = false end
            myHrp.CFrame = best.CFrame + Vector3.new(0, 3, 0)
        end
    end, RENK.cyan)

    newSection(p, "secObjects", RENK.turuncu)
    newButton(p, "tpNearestObj", function()
        local myHrp = getHRP()
        if not myHrp then return end
        local best, bestD = nil, math.huge
        local keywords = {"ball", "cube", "sofa", "couch", "clock", "barrier",
                         "шарик", "кубик", "диван", "час", "преград"}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local n = obj.Name:lower()
                for _, kw in ipairs(keywords) do
                    if n:find(kw) then
                        local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                        if pos then
                            local d = (pos - myHrp.Position).Magnitude
                            if d < bestD and d < 500 then
                                bestD = d
                                best = pos
                            end
                        end
                    end
                end
            end
        end
        if best then
            if godActive then stopGod(); State.GodMode = false end
            myHrp.CFrame = CFrame.new(best + Vector3.new(0, 3, 0))
        end
    end, RENK.turuncu)

    newSection(p, "secLocations", RENK.mor)
    newButton(p, "tpSpawn", function()
        if godActive then stopGod(); State.GodMode = false end
        local myHrp = getHRP()
        if not myHrp then return end
        local sp = Workspace:FindFirstChildOfClass("SpawnLocation")
        if sp then
            myHrp.CFrame = CFrame.new(sp.Position + Vector3.new(0, 3, 0))
            return
        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("spawn") or n:find("спавн") then
                    myHrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 3, 0))
                    return
                end
            end
        end
    end, RENK.mor)
end

