local State = {
    InfJump = false, JumpPower = false, JumpPowerValue = 10,
    Noclip = false,
    GodMode = false, GodHeight = 10, GodSpeed = 30,
    ESP_Players = false, ESP_Monster = false,
}

local function getChar() return LocalPlayer.Character end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function findMonster()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            if not Players:GetPlayerFromCharacter(obj) and obj ~= LocalPlayer.Character then
                return obj
            end
        end
    end
    return nil
end

-- ================= GOD MODE =================
local godBaseY = nil
local godActive = false

local function startGod()
    local hrp = getHRP()
    if not hrp then return end
    godBaseY = hrp.Position.Y + State.GodHeight
    godActive = true
    local hum = getHum()
    if hum then hum.PlatformStand = true end
    hrp.Anchored = false
end

local function stopGod()
    godActive = false
    godBaseY = nil
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

RunService.RenderStepped:Connect(function()
    if not godActive then return end
    if not State.GodMode then return end
    local hrp = getHRP()
    local hum = getHum()
    if not hrp or not hum then return end
    if not godBaseY then return end

    local dt = 1/60
    local move = hum.MoveDirection
    local speed = State.GodSpeed * 0.4
    local newX = hrp.Position.X
    local newZ = hrp.Position.Z
    if move.Magnitude > 0 then
        newX = newX + move.X * speed * dt
        newZ = newZ + move.Z * speed * dt
    end
    hrp.CFrame = CFrame.new(newX, godBaseY, newZ)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end)

-- ================= INF JUMP =================
UserInputService.JumpRequest:Connect(function()
    if not State.InfJump then return end
    local hum = getHum()
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

-- ================= JUMP POWER =================
RunService.RenderStepped:Connect(function()
    if not State.JumpPower then return end
    local hum = getHum(); if not hum then return end
    pcall(function() hum.UseJumpPower = true end)
    local target = State.JumpPowerValue == 0 and 0 or (State.JumpPowerValue * 5)
    if hum.JumpPower ~= target then hum.JumpPower = target end
end)

-- ================= NOCLIP =================
local noclipTracked = {}
RunService.Stepped:Connect(function()
    if not State.Noclip then return end
    local c = getChar(); if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            if noclipTracked[part] == nil then noclipTracked[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end)

local function restoreNoclip()
    for part, val in pairs(noclipTracked) do
        if part and part.Parent then part.CanCollide = val end
    end
    noclipTracked = {}
end

