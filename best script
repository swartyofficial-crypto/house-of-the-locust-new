local function switchPage(activeTab)
    PagePlayer.Visible = (activeTab == tabList[1])
    PageTP.Visible = (activeTab == tabList[2])
    PageESP.Visible = (activeTab == tabList[3])
    PageSettings.Visible = (activeTab == tabList[4])
    for _, btn in ipairs(tabList) do
        local s = tabStrokes[btn]
        if btn == activeTab then
            btn.BackgroundTransparency = 0.75
            btn.TextColor3 = RENK.beyaz
            if s then s.Color = RENK.cyan; s.Transparency = 0 end
        else
            btn.BackgroundTransparency = 0.92
            btn.TextColor3 = RENK.gri
            if s then s.Color = RENK.kenar; s.Transparency = 0.5 end
        end
    end
    aktifTab = activeTab
end

for _, btn in ipairs(tabList) do
    btn.MouseButton1Click:Connect(function()
        tikSesi()
        switchPage(btn)
    end)
end
