local function updateAllTexts()
    local t = T()
    for _, entry in ipairs(TextElements) do
        local obj = entry.obj
        local key = entry.key
        if obj and key and t[key] then
            if entry.type == "section" then
                obj.Text = "· " .. t[key] .. " ·"
            elseif entry.type == "toggle" then
                obj.Text = t[key] .. ": " .. (entry.isOn and t.on or t.off)
            elseif entry.type == "slider" then
                obj.Text = t[key] .. ": " .. tostring(entry.value)
            else
                obj.Text = t[key]
            end
        end
    end
end

